{
  "name": "elysium-settlement-monitor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,green \"tsx watch server/index.ts\" \"vite --config vite.config.ts\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --config vite.config.ts",
    "build": "vite build --config vite.config.ts",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "gsap": "^3.12.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}