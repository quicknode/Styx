# Which Elysium network to monitor: testnet | mainnet
NETWORK=mainnet
PORT=8787

# Quicknode Elysium endpoints (create at quicknode.com; Arbitrum arb_* methods are needed for the tx ladder)
ELYSIUM_MAINNET_HTTP=
ELYSIUM_MAINNET_WS=
ELYSIUM_TESTNET_HTTP=
ELYSIUM_TESTNET_WS=

# Quicknode HyperEVM endpoints (parent chain, where the rollup contracts live)
HYPEREVM_MAINNET_HTTP=
HYPEREVM_TESTNET_HTTP=

# How far back to backfill rollup events on start, in HyperEVM blocks (1 block = 1 s)
BACKFILL_BLOCKS=10800
